{
  "app-id": "io.github.yrmuq.shinpi",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "shinpi",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=all",
    "--share=ipc",
    "--system-talk-name=org.bluez",
    "--system-talk-name=org.freedesktop.UPower",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.KWin"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {"CARGO_HOME": "/run/build/shinpi/cargo"}
  },
  "modules": [{
    "name": "shinpi",
    "buildsystem": "simple",
    "build-commands": [
      "cargo build --offline --locked --release",
      "install -Dm755 target/release/shinpi /app/bin/shinpi",
      "install -Dm644 packaging/io.github.yrmuq.shinpi.desktop /app/share/applications/io.github.yrmuq.shinpi.desktop",
      "sed -i 's/Icon=shinpi/Icon=io.github.yrmuq.shinpi/' /app/share/applications/io.github.yrmuq.shinpi.desktop",
      "install -Dm644 assets/icon.svg /app/share/icons/hicolor/scalable/apps/io.github.yrmuq.shinpi.svg",
      "install -d /app/share/shinpi/languages /app/share/doc/shinpi",
      "cp languages/*.ini /app/share/shinpi/languages/",
      "cp LICENSE NOTICE ui/icons/COPYING packaging/70-shinpi.rules /app/share/doc/shinpi/"
    ],
    "sources": [{
      "type": "dir",
      "path": "../..",
      "skip": [".git", "target", "dist", ".flatpak-builder", "flatpak-build", "flatpak-repo", "packaging/appimage/build"]
    }]
  }]
}
