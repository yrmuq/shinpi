import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, SpinBox } from "std-widgets.slint";

export global Translations {
    in-out property <[string]> strings;
    public pure function tr(index: int) -> string { return strings[index]; }
}

export struct DeviceRow {
    name: string,
    charge: string,
    detail: string,
    icon: image,
    tint: bool,
    charge-color: color,
    has-percent: bool,
    added: bool,
}

export struct NoticeRow {
    index: int,
    message: string,
    when: string,
    fade: float,
}

export struct Attribution {
    name: string,
    upstream: string,
    detail: string,
    url: string,
}

// Colors are filled from the active KDE scheme. Defaults are current Breeze Light.
export global Breeze {
    in-out property <bool> dark: false;
    in-out property <color> window: #eff0f1;
    in-out property <color> button: #fcfcfc;
    in-out property <color> button-hover: #f6f6f7;
    in-out property <color> fg: #232629;
    in-out property <color> inactive: #707d8a;
    in-out property <color> selection: #3daee9;
    in-out property <color> selection-fg: #ffffff;
    in-out property <color> frame: #c6c8c9;
    // Breeze focusOutlineColor: 85% accent mixed with 15% text.
    in-out property <color> outline: #399acc;
    out property <length> radius: 5px;
}

component ToolButton inherits Rectangle {
    in property <bool> active: false;
    in property <bool> flat: false;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: Breeze.radius;
    background: flat ? transparent : (active ? Breeze.selection : (hover.has-hover || keys.has-focus ? Breeze.button-hover : transparent));
    border-width: active || keys.has-focus ? 1px : 0;
    border-color: Breeze.outline;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            @children
        }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    in property <string> label;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component BreezeIcon inherits Rectangle {
    in property <image> source;
    in property <bool> tint: true;
    in property <color> ink;
    width: 22px;
    height: 22px;
    background: transparent;
    if root.tint: Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.source;
        colorize: root.ink;
    }
    if !root.tint: Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.source;
    }
}


component DeviceLine inherits Rectangle {
    in property <DeviceRow> entry;
    in property <bool> show-source: false;
    in property <bool> editable: false;
    callback edit();
    height: 40px;
    min-width: 0px;
    // Rounded clipping resamples text through an intermediate texture.
    border-radius: Breeze.radius;
    border-width: 1px;
    border-color: Breeze.frame;
    background: Breeze.button;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.editable: ToolButton {
            height: root.height;
            flat: true;
            label: Translations.tr(48) + " " + root.entry.name;
            clicked => { root.edit(); }
            BreezeIcon { source: @image-url("icons/edit.svg"); ink: Breeze.fg; }
        }
        Rectangle {
            width: 22px;
            background: transparent;
            VerticalLayout {
                alignment: center;
                BreezeIcon { source: root.entry.icon; tint: root.entry.tint; ink: Breeze.fg; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.entry.name; color: Breeze.fg; min-width: 0px; overflow: elide; horizontal-stretch: 1; }
            if root.show-source: Text { text: root.entry.detail; color: Breeze.inactive; min-width: 0px; font-size: 11px; overflow: elide; }
        }
        Text {
            text: root.entry.charge;
            color: root.entry.has-percent ? root.entry.charge-color : Breeze.fg;
            font-weight: 600;
            vertical-alignment: center;
            min-width: 66px;
            horizontal-alignment: right;
        }
        @children
    }
}

export component Popup inherits Window {
    title: "shinpi-devices";
    icon: @image-url("../assets/icon.svg");
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in-out property <int> panel-width: 300;
    in-out property <bool> history-enabled: true;
    in-out property <bool> history-hidden: false;
    callback history-toggled();
    width: panel-width * 1px;
    height: 16px + 36px + Math.min(420px, Math.max(88px, rows.length * 46px));
    out property <length> layout-height: root.height;
    in-out property <[DeviceRow]> rows;
    in-out property <bool> pinned;
    in-out property <bool> busy;
    in-out property <bool> dark;
    in-out property <length> slide: 0px;
    in-out property <string> ui-font-family: "Noto Sans";
    in-out property <length> ui-font-size: 13.333px;
    in-out property <int> ui-font-weight: 400;
    in-out property <image> icon-configure: @image-url("icons/configure.svg");
    in-out property <image> icon-pin: @image-url("icons/window-pin.svg");
    in-out property <bool> tint-configure: true;
    in-out property <bool> tint-pin: true;
    default-font-family: ui-font-family;
    default-font-size: ui-font-size;
    default-font-weight: ui-font-weight;
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    callback configure();
    callback add();
    callback pin-toggled();
    Rectangle {
        y: root.slide;
        width: parent.width;
        height: parent.height;
        opacity: 1 - Math.min(root.slide / Math.max(root.height, 1px), 1);
        background: Breeze.window;
        border-radius: Breeze.radius;
        border-width: 1px;
        border-color: Breeze.frame;
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            Rectangle {
                height: 32px;
                background: transparent;
                Text {
                    x: 8px;
                    width: root.history-enabled ? (parent.width - 32px) / 2 - 16px : parent.width - 84px;
                    overflow: elide;
                    height: parent.height;
                    text: Translations.tr(1);
                    color: Breeze.fg;
                    vertical-alignment: center;
                    font-weight: 600;
                }
                if root.history-enabled: ToolButton {
                    x: (parent.width - self.width) / 2;
                    label: root.history-hidden ? Translations.tr(2) : Translations.tr(3);
                    clicked => { root.history-toggled(); }
                    Path {
                        width: 12px; height: 12px;
                        viewbox-width: 12; viewbox-height: 12;
                        fill: Breeze.fg;
                        commands: root.history-hidden ? "M 1 9 L 6 3 L 11 9 Z" : "M 1 3 L 6 9 L 11 3 Z";
                    }
                }
                ToolButton {
                    x: parent.width - 68px;
                    label: Translations.tr(4);
                    clicked => { root.configure(); }
                    BreezeIcon { source: root.icon-configure; tint: root.tint-configure; ink: Breeze.fg; }
                }
                pin-btn := ToolButton {
                    x: parent.width - 32px;
                    label: Translations.tr(5);
                    active: root.pinned;
                    clicked => { root.pin-toggled(); }
                    BreezeIcon { source: root.icon-pin; tint: root.tint-pin; ink: pin-btn.active ? Breeze.selection-fg : Breeze.fg; }
                }
            }
            if root.rows.length == 0: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Button { text: Translations.tr(6); clicked => { root.add(); } }
                }
            }
            if root.rows.length > 0: ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    spacing: 6px;
                    for row in root.rows: DeviceLine { entry: row; }

                }
            }
        }
    }
}

export component Notices inherits Window {
    title: "shinpi-notices";
    icon: @image-url("../assets/icon.svg");
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in-out property <bool> dark;
    in-out property <string> ui-font-family: "Noto Sans";
    in-out property <length> ui-font-size: 13.333px;
    in-out property <int> ui-font-weight: 400;
    default-font-family: ui-font-family;
    default-font-size: ui-font-size;
    default-font-weight: ui-font-weight;
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    in-out property <[NoticeRow]> notes;
    in-out property <int> panel-width: 300;
    in-out property <length> available-height: 360px;
    in-out property <bool> expanded: false;
    out property <length> slide: expanded ? 0px : root.height;
    animate slide { duration: 180ms; easing: ease-out; }
    width: panel-width * 1px;
    height: Math.min(available-height, 16px + notes.length * 72px);
    callback dismiss-note(int);
    Rectangle {
        y: root.slide;
        width: parent.width;
        height: parent.height;
        clip: true;
        opacity: 1 - root.slide / Math.max(root.height, 1px);
        ScrollView {
            content-width: self.visible-width;
            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 1px;
                for note in root.notes: Rectangle {
                    height: 71px;
                    clip: true;
                    Rectangle {
                        y: (1 - note.fade) * 71px;
                        width: parent.width;
                        height: parent.height;
                        opacity: note.fade;
                        animate opacity, y { duration: 60ms; }
                        background: Breeze.window;
                        border-radius: Breeze.radius;
                        border-width: 1px;
                        border-color: Breeze.frame;
                        VerticalLayout {
                            x: 8px;
                            width: parent.width - 40px;
                            height: parent.height;
                            alignment: center;
                            spacing: 0px;
                            Text { text: Translations.tr(7); color: Breeze.fg; font-weight: 600; overflow: elide; min-width: 0px; height: 18px; }
                            Text { text: note.message; color: Breeze.fg; overflow: elide; min-width: 0px; height: 18px; }
                            Text { text: note.when; color: Breeze.inactive; overflow: elide; min-width: 0px; font-size: root.ui-font-size * 0.85; height: 16px; }
                        }
                        ToolButton {
                            x: parent.width - 32px;
                            label: Translations.tr(8);
                            clicked => { root.dismiss-note(note.index); }
                            Text { text: "×"; color: Breeze.inactive; font-size: 18px; }
                        }
                    }
                }
            }
        }
    }
}

component AddDevices inherits Rectangle {
    width: 560px;
    height: 440px;
    background: Breeze.window;
    border-radius: Breeze.radius;
    border-width: 1px;
    border-color: Breeze.frame;
    clip: true;
    in-out property <[DeviceRow]> rows;
    in-out property <bool> busy;
    callback add-device(int);
    callback refresh();
    callback dismiss();
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        Text { text: Translations.tr(9); color: Breeze.fg; font-weight: 600; }
        Text { text: Translations.tr(10); color: Breeze.inactive; wrap: word-wrap; }
        if root.rows.length == 0: Text { text: root.busy ? Translations.tr(11) : Translations.tr(12); color: Breeze.inactive; wrap: word-wrap; }
        ScrollView {
            content-width: self.visible-width;
            VerticalLayout {
                spacing: 6px;
                for device[i] in root.rows: DeviceLine {
                    entry: device;
                    show-source: true;
                    height: 58px;
                    ToolButton {
                        height: 58px;
                        active: device.added;
                        label: device.added ? Translations.tr(13) : Translations.tr(6) + " " + device.name;
                        clicked => { if (!device.added) { root.add-device(i); } }
                        Text { text: device.added ? "✓" : "+"; font-size: 24px; color: device.added ? Breeze.selection-fg : Breeze.fg; }
                    }
                }
            }
        }
        HorizontalLayout {
            Button { text: Translations.tr(14); enabled: !root.busy; clicked => { root.refresh(); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Button { text: Translations.tr(15); clicked => { root.dismiss(); } }
        }
    }
}

component DeviceEditor inherits Rectangle {
    width: 440px;
    height: 270px;
    background: Breeze.window;
    border-radius: Breeze.radius;
    border-width: 1px;
    border-color: Breeze.frame;
    clip: true;
    in-out property <string> device-name;
    in-out property <int> kind-index;
    in-out property <string> error;
    callback save-device(string, int);
    callback dismiss();
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text { text: Translations.tr(16); color: Breeze.fg; }
        LineEdit { text <=> root.device-name; }
        Text { text: Translations.tr(17); color: Breeze.fg; }
        ComboBox {
            model: [Translations.tr(18), Translations.tr(19), Translations.tr(20), Translations.tr(21), Translations.tr(22)];
            current-index <=> root.kind-index;
        }
        if root.error != "": Text { text: root.error; color: #da4453; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            Button { text: Translations.tr(23); clicked => { root.dismiss(); } }
            Button { text: Translations.tr(24); clicked => { root.save-device(root.device-name, root.kind-index); } }
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 260px;
    spacing: 16px;
    Text {
        text: root.label;
        color: Breeze.fg;
        width: root.label-width;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    @children
}

component AboutLink inherits Rectangle {
    in property <string> label;
    callback activate;
    background: transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activate(); }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " ") { root.activate(); return accept; }
            return reject;
        }
    }
    border-width: keys.has-focus ? 1px : 0px;
    border-color: Breeze.outline;
    VerticalLayout {
        spacing: 0px;
        Text { text: root.label; color: Breeze.selection; }
        Rectangle { height: 1px; background: Breeze.selection; }
    }
    TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { keys.focus(); root.activate(); }
    }
}

component PageTabs inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> selected;
    height: 32px;
    accessible-role: tab-list;
    accessible-item-count: root.labels.length;
    accessible-delegate-focus: root.selected;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.Home) {
                root.selected = event.text == Key.Home ? 0 : Math.max(0, root.selected - 1);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.End) {
                root.selected = event.text == Key.End ? root.labels.length - 1 : Math.min(root.labels.length - 1, root.selected + 1);
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        spacing: 2px;
        for label[index] in root.labels: Rectangle {
            accessible-role: tab;
            accessible-label: label;
            accessible-item-index: index;
            accessible-item-selectable: true;
            accessible-item-selected: root.selected == index;
            accessible-action-default => { root.selected = index; keys.focus(); }
            background: root.selected == index ? Breeze.button : (touch.has-hover ? Breeze.button-hover : transparent);
            border-radius: Breeze.radius;
            border-width: keys.has-focus && root.selected == index ? 1px : 0px;
            border-color: Breeze.outline;
            Text {
                x: 8px; width: parent.width - 16px; height: parent.height;
                text: label; color: Breeze.fg;
                font-weight: root.selected == index ? 600 : 400;
                vertical-alignment: center; overflow: elide;
            }
            touch := TouchArea { mouse-cursor: pointer; clicked => { root.selected = index; keys.focus(); } }
        }
    }
}

component PartRow inherits VerticalLayout {
    in property <Attribution> part;
    callback open-link(string);
    spacing: 0px;
    HorizontalLayout {
        spacing: 8px;
        padding-top: 6px; padding-bottom: 6px;
        Text { text: root.part.name; width: 90px; wrap: word-wrap; color: Breeze.fg; vertical-alignment: center; }
        VerticalLayout {
            width: 145px; alignment: center;
            AboutLink { label: root.part.upstream; activate => { root.open-link(root.part.url); } }
        }
        Text { text: root.part.detail; horizontal-stretch: 1; wrap: word-wrap; color: Breeze.fg; vertical-alignment: center; }
    }
    Rectangle { height: 1px; background: Breeze.frame; }
}

export component Settings inherits Window {
    title: "shinpi";
    icon: @image-url("../assets/icon.svg");
    in-out property <int> settings-width: 600;
    in-out property <int> settings-height: 630;
    in-out property <int> logo-size: 69;
    in-out property <bool> lock-window-size: true;
    property <bool> icons-expanded: false;
    callback lock-window-size-changed(bool);
    in-out property <bool> dev-open;
    in-out property <string> dev-report;
    in-out property <[Attribution]> parts;
    callback logo-tapped();
    callback metrics-changed(int, int, int);
    callback reset-dev();
    callback reset-appearance();
    preferred-width: settings-width * 1px;
    min-width: lock-window-size ? settings-width * 1px : 360px;
    max-width: lock-window-size ? settings-width * 1px : 2200px;
    preferred-height: settings-height * 1px;
    min-height: lock-window-size ? settings-height * 1px : 240px;
    max-height: lock-window-size ? settings-height * 1px : 1800px;
    in-out property <bool> dark;
    in-out property <int> tab-index;
    changed tab-index => { if (root.tab-index == 3) { root.check-update(); } }
    changed dev-open => { if (!root.dev-open && root.tab-index == 4) { root.tab-index = 3; } }
    in-out property <string> ui-font-family: "Noto Sans";
    in-out property <length> ui-font-size: 13.333px;
    in-out property <int> ui-font-weight: 400;
    default-font-family: ui-font-family;
    default-font-size: ui-font-size;
    default-font-weight: ui-font-weight;
    background: Breeze.window;
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    in-out property <[DeviceRow]> rows;
    in-out property <int> theme-index;
    in-out property <int> orientation;
    in-out property <bool> colored: true;
    in-out property <int> panel-width: 300;
    in-out property <int> history-count: 3;
    callback panel-width-selected(int);
    callback history-count-selected(int);
    in-out property <bool> notifications: true;
    in-out property <int> threshold: 15;
    in-out property <int> repeat-minutes: 60;
    in-out property <image> tray-preview;
    in-out property <string> diagnostics;
    in-out property <string> error;
    in-out property <[string]> language-names;
    in-out property <int> language-index;
    callback language-selected(int);
    callback theme-selected(int);
    callback orientation-selected(int);
    callback colored-selected(bool);
    callback notifications-selected(bool);
    callback threshold-selected(int);
    callback repeat-selected(int);
    callback add();
    callback edit-device(int);
    callback remove-device(int);
    in-out property <string> version;
    in-out property <string> update-status;
    in-out property <bool> checking-update;
    in-out property <bool> update-available;
    in-out property <bool> update-current;
    callback check-update();
    callback open-link(string);
    in-out property <[DeviceRow]> found-rows;
    in-out property <bool> busy;
    in-out property <string> edit-name;
    in-out property <int> edit-kind;
    in-out property <string> edit-error;
    callback add-device(int);
    callback refresh();
    callback save-device(string, int);
    public function open-add() { add-dialog.show(); }
    public function open-editor() { edit-dialog.show(); }
    public function close-editor() { edit-dialog.close(); }
    public function close-dialogs() { add-dialog.close(); edit-dialog.close(); diagnostics-dialog.close(); }
    add-dialog := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 560px;
        height: 440px;
        close-policy: no-auto-close;
        AddDevices {
            rows: root.found-rows;
            busy: root.busy;
            add-device(index) => { root.add-device(index); }
            refresh => { root.refresh(); }
            dismiss => { add-dialog.close(); }
        }
    }
    edit-dialog := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 440px;
        height: 270px;
        close-policy: no-auto-close;
        DeviceEditor {
            device-name <=> root.edit-name;
            kind-index <=> root.edit-kind;
            error: root.edit-error;
            save-device(name, kind) => { root.save-device(name, kind); }
            dismiss => { edit-dialog.close(); }
        }
    }
    diagnostics-dialog := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 548px;
        height: 440px;
        close-policy: no-auto-close;
        Rectangle {
            background: Breeze.window;
            border-radius: Breeze.radius;
            border-width: 1px;
            border-color: Breeze.frame;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text { text: Translations.tr(50); color: Breeze.fg; font-weight: 600; }
                diagnostics-scroll := ScrollView {
                    content-width: self.visible-width;
                    VerticalLayout {
                        padding: 8px;
                        alignment: start;
                        Text {
                            min-width: 0px;
                            text: root.diagnostics;
                            color: Breeze.fg;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button { text: Translations.tr(15); clicked => { diagnostics-dialog.close(); } }
                }
            }
        }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        PageTabs {
            labels: root.dev-open ? [Translations.tr(25), Translations.tr(41), Translations.tr(1), Translations.tr(93), "Dev"]
                : [Translations.tr(25), Translations.tr(41), Translations.tr(1), Translations.tr(93)];
            selected <=> root.tab-index;
        }
        Rectangle {
            vertical-stretch: 1; clip: true;
            if root.tab-index == 0: ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    padding: 12px;
                    spacing: 14px;
                    alignment: start;
                    Text { text: Translations.tr(123); color: Breeze.fg; font-weight: 600; }
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(51);
                        ComboBox {
                            model: root.language-names;
                            current-index <=> root.language-index;
                            selected(value) => { root.language-selected(self.current-index); }
                        }
                    }
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(26);
                        ComboBox {
                            model: [Translations.tr(27), Translations.tr(28), Translations.tr(29)];
                            current-index <=> root.theme-index;
                            selected(value) => { root.theme-selected(self.current-index); }
                        }
                    }
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(30);
                        ComboBox {
                            model: [Translations.tr(31), Translations.tr(32), Translations.tr(33), Translations.tr(34)];
                            current-index <=> root.orientation;
                            selected(value) => { root.orientation-selected(self.current-index); }
                        }
                        Image { source: root.tray-preview; width: 32px; height: 32px; }
                    }
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(35);
                        CheckBox {
                            accessible-label: Translations.tr(35);
                            checked <=> root.colored;
                            toggled => { root.colored-selected(self.checked); }
                        }
                    }
                    HorizontalLayout {
                        Button { text: Translations.tr(106); horizontal-stretch: 1; clicked => { root.reset-appearance(); } }
                    }
                    Rectangle { height: 1px; background: Breeze.frame; }
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(37);
                        CheckBox {
                            accessible-label: Translations.tr(37);
                            checked <=> root.notifications;
                            toggled => { root.notifications-selected(self.checked); }
                        }
                    }
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(38);
                        SpinBox {
                            enabled: root.notifications;
                            minimum: 0; maximum: 100; value <=> root.threshold;
                            edited(value) => { root.threshold-selected(value); }
                        }
                    }
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(39);
                        SpinBox {
                            enabled: root.notifications;
                            minimum: 1; maximum: 10080; value <=> root.repeat-minutes;
                            edited(value) => { root.repeat-selected(value); }
                        }
                    }
                }
            }
            if root.tab-index == 1: ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    padding: 12px;
                    spacing: 14px;
                    alignment: start;
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(42);
                        SpinBox {
                            minimum: 280; maximum: 800; value <=> root.panel-width;
                            edited(value) => { root.panel-width-selected(value); }
                        }
                    }
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(45);
                        SpinBox {
                            minimum: 0; maximum: 20; value <=> root.history-count;
                            edited(value) => { root.history-count-selected(value); }
                        }
                    }
                }
            }
            if root.tab-index == 2: VerticalLayout {
                    padding: 8px;
                    spacing: 10px;
                    if root.rows.length == 0: Text { text: Translations.tr(47); color: Breeze.inactive; wrap: word-wrap; vertical-stretch: 0; }
                    if root.rows.length > 0: ScrollView {
                        max-height: Math.max(70px, root.rows.length * 64px);
                        content-width: self.visible-width;
                        VerticalLayout {
                            spacing: 6px;
                            for device[i] in root.rows: DeviceLine {
                                entry: device;
                                show-source: true;
                                height: 58px;
                                editable: true;
                                edit => { root.edit-device(i); }
                                ToolButton {
                                    height: 58px;
                                    label: Translations.tr(49) + " " + device.name;
                                    flat: true;
                                    clicked => { root.remove-device(i); }
                                    Text { text: "×"; font-size: 24px; color: #da4453; }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        Button { text: Translations.tr(50); horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; clicked => { diagnostics-dialog.show(); } }
                        Button { text: Translations.tr(6); horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; clicked => { root.add(); } }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            if root.tab-index == 3: ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    padding-left: 23px; padding-right: 23px;
                    padding-top: 23px; padding-bottom: 12px;
                    spacing: 8px; alignment: start;
                    HorizontalLayout {
                        alignment: center;
                        ToolButton {
                            width: root.logo-size * 1px; height: root.logo-size * 1px;
                            flat: true; label: "shinpi";
                            clicked => { root.logo-tapped(); }
                            Image { source: @image-url("../assets/icon.svg"); width: 100%; height: 100%; image-fit: contain; }
                        }
                    }
                    Text { text: "shinpi"; font-size: 16px; font-weight: 700; color: Breeze.fg; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: start; spacing: 6px;
                        Text { text: Translations.tr(95) + ":"; color: Breeze.fg; vertical-alignment: center; }
                        AboutLink { label: "github"; activate => { root.open-link("https://github.com/yrmuq/shinpi"); } }
                    }
                    HorizontalLayout {
                        alignment: start; spacing: 6px;
                        Text { text: Translations.tr(114); color: Breeze.fg; vertical-alignment: center; }
                        AboutLink { label: "GPL-3.0-or-later"; activate => { root.open-link("https://github.com/yrmuq/shinpi/blob/main/LICENSE"); } }
                    }
                    Text { text: Translations.tr(94) + ": " + root.version; color: Breeze.fg; }
                    if root.update-status != "": Text {
                        text: root.update-status; wrap: word-wrap;
                        color: root.update-current ? #27ae60 : Breeze.fg;
                    }
                    if root.update-available: HorizontalLayout {
                        alignment: start;
                        Button { text: Translations.tr(98); clicked => { root.open-link("https://github.com/yrmuq/shinpi/releases/latest"); } }
                    }
                    Rectangle { height: root.ui-font-size * 2; background: transparent; }
                    ScrollView {
                        height: parts-table.preferred-height + 14px;
                        vertical-scrollbar-policy: always-off;
                        content-width: Math.max(self.visible-width, 520px);
                        content-height: parts-table.preferred-height;
                        parts-table := VerticalLayout {
                            spacing: 0px;
                            HorizontalLayout {
                                spacing: 8px; padding-bottom: 4px;
                                Text { text: Translations.tr(110); font-weight: 700; color: Breeze.fg; width: 90px; }
                                Text { text: Translations.tr(111); font-weight: 700; color: Breeze.fg; width: 145px; }
                                Text { text: Translations.tr(112); font-weight: 700; color: Breeze.fg; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                            Rectangle { height: 1px; background: Breeze.frame; }
                            for part in root.parts: PartRow { part: part; open-link(url) => { root.open-link(url); } }
                        }
                    }
                }
            }
            if root.tab-index == 4 && root.dev-open: ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    padding: 12px; spacing: 14px; alignment: start;
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(107);
                        SpinBox { minimum: 360; maximum: 2200; value <=> root.settings-width;
                            edited => { root.metrics-changed(root.settings-width, root.settings-height, root.logo-size); } }
                    }
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(108);
                        SpinBox { minimum: 240; maximum: 1800; value <=> root.settings-height;
                            edited => { root.metrics-changed(root.settings-width, root.settings-height, root.logo-size); } }
                    }
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(109);
                        SpinBox { minimum: 32; maximum: 256; value <=> root.logo-size;
                            edited => { root.metrics-changed(root.settings-width, root.settings-height, root.logo-size); } }
                    }
                    SettingRow {
                        label-width: Math.min(260px, (root.settings-width - 48) * 0.45px);
                        label: Translations.tr(124);
                        CheckBox {
                            checked <=> root.lock-window-size;
                            accessible-label: Translations.tr(124);
                            toggled => { root.lock-window-size-changed(self.checked); }
                        }
                    }
                    Button {
                        text: (root.icons-expanded ? "▾ " : "▸ ") + Translations.tr(116);
                        accessible-label: Translations.tr(116);
                        accessible-expandable: true;
                        accessible-expanded: root.icons-expanded;
                        clicked => { root.icons-expanded = !root.icons-expanded; }
                    }
                    if root.icons-expanded: Text { text: root.dev-report; color: Breeze.fg; wrap: word-wrap; }
                    HorizontalLayout {
                        Button { text: Translations.tr(106); horizontal-stretch: 1; clicked => { root.reset-dev(); } }
                    }
                }
            }
        }
        if root.error != "": Text { text: root.error; color: #da4453; wrap: word-wrap; }
    }
}
