import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, SpinBox, TabWidget } from "std-widgets.slint";

export struct DeviceRow {
    name: string,
    charge: string,
    detail: string,
    icon: image,
    tint: bool,
    low: bool,
    added: bool,
}

export struct NoticeRow {
    index: int,
    message: string,
    when: string,
    fade: float,
}

// Colors are filled from the active KDE scheme. Defaults are current Breeze Light.
export global Breeze {
    in-out property <bool> dark: false;
    in-out property <color> window: #eff0f1;
    in-out property <color> button: #fcfcfc;
    in-out property <color> button-hover: #f6f6f7;
    in-out property <color> fg: #232629;
    in-out property <color> inactive: #707d8a;
    in-out property <color> selection: #3daee9;
    in-out property <color> selection-fg: #ffffff;
    in-out property <color> frame: #c6c8c9;
    // Breeze focusOutlineColor: 85% accent mixed with 15% text.
    in-out property <color> outline: #399acc;
    out property <length> radius: 5px;
}

component ToolButton inherits Rectangle {
    in property <bool> active: false;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: Breeze.radius;
    background: active ? Breeze.selection : (hover.has-hover || keys.has-focus ? Breeze.button-hover : transparent);
    border-width: active || keys.has-focus ? 1px : 0;
    border-color: Breeze.outline;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            @children
        }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    in property <string> label;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component BreezeIcon inherits Rectangle {
    in property <image> source;
    in property <bool> tint: true;
    in property <color> ink;
    width: 22px;
    height: 22px;
    background: transparent;
    if root.tint: Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.source;
        colorize: root.ink;
    }
    if !root.tint: Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.source;
    }
}


component DeviceLine inherits Rectangle {
    in property <DeviceRow> entry;
    in property <bool> show-source: false;
    height: 40px;
    min-width: 0px;
    clip: true;
    border-radius: Breeze.radius;
    border-width: 1px;
    border-color: Breeze.frame;
    background: Breeze.button;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle {
            width: 22px;
            background: transparent;
            VerticalLayout {
                alignment: center;
                BreezeIcon { source: root.entry.icon; tint: root.entry.tint; ink: Breeze.fg; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.entry.name; color: Breeze.fg; min-width: 0px; overflow: elide; horizontal-stretch: 1; }
            if root.show-source: Text { text: root.entry.detail; color: Breeze.inactive; min-width: 0px; font-size: 11px; overflow: elide; }
        }
        Text {
            text: root.entry.charge;
            color: root.entry.low ? #da4453 : Breeze.fg;
            font-weight: 600;
            vertical-alignment: center;
            min-width: 66px;
            horizontal-alignment: right;
        }
        @children
    }
}

export component Popup inherits Window {
    title: "shinpi-devices";
    icon: @image-url("../assets/icon.svg");
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in-out property <int> panel-width: 360;
    in-out property <bool> history-enabled: true;
    in-out property <bool> history-hidden: false;
    callback history-toggled();
    width: panel-width * 1px;
    height: 16px + 36px + Math.min(420px, Math.max(88px, rows.length * 46px));
    out property <length> layout-height: root.height;
    in-out property <[DeviceRow]> rows;
    in-out property <bool> pinned;
    in-out property <bool> busy;
    in-out property <bool> dark;
    in-out property <length> slide: 0px;
    in-out property <string> ui-font-family: "Noto Sans";
    in-out property <length> ui-font-size: 13.333px;
    in-out property <int> ui-font-weight: 400;
    in-out property <string> empty-message: "Поиск устройств…";
    in-out property <image> icon-configure: @image-url("icons/configure.svg");
    in-out property <image> icon-pin: @image-url("icons/window-pin.svg");
    in-out property <image> icon-refresh: @image-url("icons/refresh.svg");
    in-out property <bool> tint-configure: true;
    in-out property <bool> tint-pin: true;
    in-out property <bool> tint-refresh: true;
    default-font-family: ui-font-family;
    default-font-size: ui-font-size;
    default-font-weight: ui-font-weight;
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    callback configure();
    callback add();
    callback pin-toggled();
    callback refresh();
    Rectangle {
        y: root.slide;
        width: parent.width;
        height: parent.height;
        opacity: 1 - Math.min(root.slide / Math.max(root.height, 1px), 1);
        background: Breeze.window;
        border-radius: Breeze.radius;
        border-width: 1px;
        border-color: Breeze.frame;
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            Rectangle {
                height: 32px;
                background: transparent;
                Text {
                    x: 8px;
                    width: parent.width - (root.history-enabled ? 152px : 116px);
                    height: parent.height;
                    text: "Устройства";
                    color: Breeze.fg;
                    vertical-alignment: center;
                    font-weight: 600;
                }
                if root.history-enabled: ToolButton {
                    x: parent.width - 140px;
                    label: root.history-hidden ? "Показать уведомления" : "Скрыть уведомления";
                    clicked => { root.history-toggled(); }
                    Path {
                        width: 12px; height: 12px;
                        viewbox-width: 12; viewbox-height: 12;
                        fill: Breeze.fg;
                        commands: root.history-hidden ? "M 1 9 L 6 3 L 11 9 Z" : "M 1 3 L 6 9 L 11 3 Z";
                    }
                }
                ToolButton {
                    x: parent.width - 104px;
                    label: "Обновить";
                    clicked => { if (!root.busy) { root.refresh(); } }
                    BreezeIcon { source: root.icon-refresh; tint: root.tint-refresh; ink: root.busy ? Breeze.inactive : Breeze.fg; }
                }
                ToolButton {
                    x: parent.width - 68px;
                    label: "Настройки";
                    clicked => { root.configure(); }
                    BreezeIcon { source: root.icon-configure; tint: root.tint-configure; ink: Breeze.fg; }
                }
                pin-btn := ToolButton {
                    x: parent.width - 32px;
                    label: "Закрепить окно";
                    active: root.pinned;
                    clicked => { root.pin-toggled(); }
                    BreezeIcon { source: root.icon-pin; tint: root.tint-pin; ink: pin-btn.active ? Breeze.selection-fg : Breeze.fg; }
                }
            }
            if root.rows.length == 0: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Button { text: "Add"; clicked => { root.add(); } }
                }
            }
            if root.rows.length > 0: ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    spacing: 6px;
                    for row in root.rows: DeviceLine { entry: row; }

                }
            }
        }
    }
}

export component Notices inherits Window {
    title: "shinpi-notices";
    icon: @image-url("../assets/icon.svg");
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in-out property <bool> dark;
    in-out property <string> ui-font-family: "Noto Sans";
    in-out property <length> ui-font-size: 13.333px;
    in-out property <int> ui-font-weight: 400;
    default-font-family: ui-font-family;
    default-font-size: ui-font-size;
    default-font-weight: ui-font-weight;
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    in-out property <[NoticeRow]> notes;
    in-out property <int> panel-width: 360;
    in-out property <length> available-height: 360px;
    in-out property <bool> expanded: false;
    out property <length> slide: expanded ? 0px : root.height;
    animate slide { duration: 180ms; easing: ease-out; }
    width: panel-width * 1px;
    height: Math.min(available-height, 16px + notes.length * 72px);
    callback dismiss-note(int);
    Rectangle {
        y: root.slide;
        width: parent.width;
        height: parent.height;
        clip: true;
        opacity: 1 - root.slide / Math.max(root.height, 1px);
        ScrollView {
            content-width: self.visible-width;
            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 1px;
                for note in root.notes: Rectangle {
                    height: 71px;
                    clip: true;
                    Rectangle {
                        y: (1 - note.fade) * 71px;
                        width: parent.width;
                        height: parent.height;
                        opacity: note.fade;
                        animate opacity, y { duration: 60ms; }
                        background: Breeze.window;
                        border-radius: Breeze.radius;
                        border-width: 1px;
                        border-color: Breeze.frame;
                        VerticalLayout {
                            x: 8px;
                            width: parent.width - 40px;
                            height: parent.height;
                            alignment: center;
                            spacing: 0px;
                            Text { text: "Низкий заряд устройства"; color: Breeze.fg; font-weight: 600; overflow: elide; min-width: 0px; height: 18px; }
                            Text { text: note.message; color: Breeze.fg; overflow: elide; min-width: 0px; height: 18px; }
                            Text { text: note.when; color: Breeze.inactive; overflow: elide; min-width: 0px; font-size: root.ui-font-size * 0.85; height: 16px; }
                        }
                        ToolButton {
                            x: parent.width - 32px;
                            label: "Удалить уведомление";
                            clicked => { root.dismiss-note(note.index); }
                            Text { text: "×"; color: Breeze.inactive; font-size: 18px; }
                        }
                    }
                }
            }
        }
    }
}

component AddDevices inherits Rectangle {
    width: 560px;
    height: 440px;
    background: Breeze.window;
    border-radius: Breeze.radius;
    border-width: 1px;
    border-color: Breeze.frame;
    clip: true;
    in-out property <[DeviceRow]> rows;
    in-out property <bool> busy;
    callback add-device(int);
    callback refresh();
    callback dismiss();
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        Text { text: "Найденные устройства"; color: Breeze.fg; font-weight: 600; }
        Text { text: "Каждый источник показан отдельно. Выберите подходящий вариант."; color: Breeze.inactive; wrap: word-wrap; }
        if root.rows.length == 0: Text { text: root.busy ? "Поиск устройств…" : "Устройств не найдено. Подключите устройство и обновите список."; color: Breeze.inactive; wrap: word-wrap; }
        ScrollView {
            content-width: self.visible-width;
            VerticalLayout {
                spacing: 6px;
                for device[i] in root.rows: DeviceLine {
                    entry: device;
                    show-source: true;
                    height: 58px;
                    ToolButton {
                        height: 58px;
                        active: device.added;
                        label: device.added ? "Устройство добавлено" : "Добавить " + device.name;
                        clicked => { if (!device.added) { root.add-device(i); } }
                        Text { text: device.added ? "✓" : "+"; font-size: 24px; color: device.added ? Breeze.selection-fg : Breeze.fg; }
                    }
                }
            }
        }
        HorizontalLayout {
            Button { text: "Обновить"; enabled: !root.busy; clicked => { root.refresh(); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Button { text: "Закрыть"; clicked => { root.dismiss(); } }
        }
    }
}

component DeviceEditor inherits Rectangle {
    width: 440px;
    height: 270px;
    background: Breeze.window;
    border-radius: Breeze.radius;
    border-width: 1px;
    border-color: Breeze.frame;
    clip: true;
    in-out property <string> device-name;
    in-out property <int> kind-index;
    in-out property <string> error;
    callback save-device(string, int);
    callback dismiss();
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text { text: "Название"; color: Breeze.fg; }
        LineEdit { text <=> root.device-name; }
        Text { text: "Значок устройства"; color: Breeze.fg; }
        ComboBox {
            model: ["Мышь", "Клавиатура", "Наушники", "Геймпад", "Батарея"];
            current-index <=> root.kind-index;
        }
        if root.error != "": Text { text: root.error; color: #da4453; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            Button { text: "Отмена"; clicked => { root.dismiss(); } }
            Button { text: "Сохранить"; clicked => { root.save-device(root.device-name, root.kind-index); } }
        }
    }
}

export component Settings inherits Window {
    title: "shinpi";
    icon: @image-url("../assets/icon.svg");
    preferred-width: 600px;
    min-width: 600px;
    max-width: 600px;
    preferred-height: 620px;
    min-height: 620px;
    max-height: 620px;
    in-out property <bool> dark;
    in-out property <string> ui-font-family: "Noto Sans";
    in-out property <length> ui-font-size: 13.333px;
    in-out property <int> ui-font-weight: 400;
    default-font-family: ui-font-family;
    default-font-size: ui-font-size;
    default-font-weight: ui-font-weight;
    background: Breeze.window;
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    in-out property <[DeviceRow]> rows;
    in-out property <int> theme-index;
    in-out property <int> orientation;
    in-out property <bool> colored: true;
    in-out property <int> panel-width: 360;
    in-out property <bool> history-enabled: true;
    in-out property <int> history-count: 3;
    callback panel-width-selected(int);
    callback history-enabled-selected(bool);
    callback history-count-selected(int);
    in-out property <bool> notifications: true;
    in-out property <int> threshold: 15;
    in-out property <int> repeat-minutes: 60;
    in-out property <image> tray-preview;
    in-out property <string> diagnostics;
    in-out property <string> error;
    callback theme-selected(int);
    callback orientation-selected(int);
    callback colored-selected(bool);
    callback notifications-selected(bool);
    callback threshold-selected(int);
    callback repeat-selected(int);
    callback add();
    callback edit-device(int);
    callback remove-device(int);
    callback dismiss();
    in-out property <[DeviceRow]> found-rows;
    in-out property <bool> busy;
    in-out property <string> edit-name;
    in-out property <int> edit-kind;
    in-out property <string> edit-error;
    callback add-device(int);
    callback refresh();
    callback save-device(string, int);
    public function open-add() { add-dialog.show(); }
    public function open-editor() { edit-dialog.show(); }
    public function close-editor() { edit-dialog.close(); }
    public function close-dialogs() { add-dialog.close(); edit-dialog.close(); }
    add-dialog := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 560px;
        height: 440px;
        close-policy: no-auto-close;
        AddDevices {
            rows: root.found-rows;
            busy: root.busy;
            add-device(index) => { root.add-device(index); }
            refresh => { root.refresh(); }
            dismiss => { add-dialog.close(); }
        }
    }
    edit-dialog := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 440px;
        height: 270px;
        close-policy: no-auto-close;
        DeviceEditor {
            device-name <=> root.edit-name;
            kind-index <=> root.edit-kind;
            error: root.edit-error;
            save-device(name, kind) => { root.save-device(name, kind); }
            dismiss => { edit-dialog.close(); }
        }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: "Общие";
                VerticalLayout {
                    padding: 12px;
                    spacing: 14px;
                    alignment: start;
                    HorizontalLayout {
                        Text { text: "Тема"; color: Breeze.fg; vertical-alignment: center; }
                        ComboBox {
                            model: ["Системная", "Светлая", "Тёмная"];
                            current-index: root.theme-index;
                            selected(value) => { root.theme-selected(self.current-index); }
                        }
                    }
                    HorizontalLayout {
                        Text { text: "Положение значка"; color: Breeze.fg; vertical-alignment: center; }
                        ComboBox {
                            model: ["Горизонтальное", "Горизонтальное реверс", "Вертикальное", "Вертикальное реверс"];
                            current-index: root.orientation;
                            selected(value) => { root.orientation-selected(self.current-index); }
                        }
                        Image { source: root.tray-preview; width: 32px; height: 32px; }
                    }
                    CheckBox {
                        text: "Цветной значок батареи";
                        checked: root.colored;
                        toggled => { root.colored-selected(self.checked); }
                    }
                    Text { text: "Монохромный значок использует контрастный цвет темы."; color: Breeze.inactive; wrap: word-wrap; }
                    Rectangle { height: 1px; background: Breeze.frame; }
                    CheckBox {
                        text: "Уведомлять о низком заряде";
                        checked: root.notifications;
                        toggled => { root.notifications-selected(self.checked); }
                    }
                    HorizontalLayout {
                        Text { text: "Порог, ≤ %"; color: Breeze.fg; vertical-alignment: center; }
                        SpinBox {
                            enabled: root.notifications;
                            minimum: 0; maximum: 100; value: root.threshold;
                            edited(value) => { root.threshold-selected(value); }
                        }
                    }
                    HorizontalLayout {
                        Text { text: "Повторять каждые, мин"; color: Breeze.fg; vertical-alignment: center; }
                        SpinBox {
                            enabled: root.notifications;
                            minimum: 1; maximum: 10080; value: root.repeat-minutes;
                            edited(value) => { root.repeat-selected(value); }
                        }
                    }
                    Text {
                        text: "Порог и интервал общие для всех устройств.\nДля текстового низкого уровня процентный порог не применяется. Во время зарядки уведомлений нет.";
                        color: Breeze.inactive; wrap: word-wrap;
                    }
                }
            }
            Tab {
                title: "Панели";
                VerticalLayout {
                    padding: 12px;
                    spacing: 14px;
                    alignment: start;
                    HorizontalLayout {
                        Text { text: "Ширина панелей, px"; color: Breeze.fg; vertical-alignment: center; }
                        SpinBox {
                            minimum: 280; maximum: 800; value: root.panel-width;
                            edited(value) => { root.panel-width-selected(value); }
                        }
                    }
                    Text { text: "Панель устройств и история уведомлений используют одну ширину."; color: Breeze.inactive; wrap: word-wrap; }
                    CheckBox {
                        text: "Показывать панель уведомлений";
                        checked: root.history-enabled;
                        toggled => { root.history-enabled-selected(self.checked); }
                    }
                    HorizontalLayout {
                        Text { text: "Последних уведомлений"; color: Breeze.fg; vertical-alignment: center; }
                        SpinBox {
                            enabled: root.history-enabled;
                            minimum: 1; maximum: 20; value: root.history-count;
                            edited(value) => { root.history-count-selected(value); }
                        }
                    }
                    Text { text: "История хранит последние 20 уведомлений о низком заряде. Треугольник в панели устройств раскрывает и скрывает историю. Системные уведомления настраиваются отдельно во вкладке «Общие»."; color: Breeze.inactive; wrap: word-wrap; }
                }
            }
            Tab {
                title: "Устройства";
                VerticalLayout {
                    padding: 8px;
                    spacing: 10px;
                    Button { text: "Add"; clicked => { root.add(); } }
                    if root.rows.length == 0: Text { text: "Добавьте устройства для показа в трее."; color: Breeze.inactive; wrap: word-wrap; }
                    ScrollView {
                        content-width: self.visible-width;
                        VerticalLayout {
                            spacing: 6px;
                            for device[i] in root.rows: DeviceLine {
                                entry: device;
                                show-source: true;
                                height: 58px;
                                ToolButton {
                                    height: 58px;
                                    label: "Изменить " + device.name;
                                    clicked => { root.edit-device(i); }
                                    BreezeIcon { source: @image-url("icons/edit.svg"); ink: Breeze.fg; }
                                }
                                Button { text: "Удалить"; clicked => { root.remove-device(i); } }
                            }
                        }
                    }
                }
            }
            Tab {
                title: "Диагностика";
                diagnostics-scroll := ScrollView {
                    content-width: self.visible-width;
                    Text {
                        width: diagnostics-scroll.visible-width - 16px;
                        min-width: 0px;
                        x: 8px;
                        text: root.diagnostics;
                        color: Breeze.fg;
                        wrap: word-wrap;
                    }
                }
            }
        }
        if root.error != "": Text { text: root.error; color: #da4453; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            Button { text: "Закрыть"; clicked => { root.dismiss(); } }
        }
    }
}
